# Copie este arquivo para .env e preencha as chaves dos provedores que for usar.
# Sem nenhuma chave, o sistema funciona em "Modo demonstração" (análise por regras).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Provedor padrão: anthropic | openai | gemini | demo
DISPUTE_AI_PROVEDOR_PADRAO=demo

# Caminho do banco SQLite (opcional)
DISPUTE_AI_DB=data/dispute_ai.db
